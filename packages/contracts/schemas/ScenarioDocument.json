  "$id": "urn:hannibal-x:contracts:1.0.0:ScenarioDocument",
  "additionalProperties": false,
  "properties": {
    "attendu": {
      "items": {
        "$ref": "#/$defs/ScenarioGoal"
      },
      "title": "Attendu",
      "type": "array"
    },
    "briefing": {
      "minLength": 1,
      "title": "Briefing",
      "type": "string"
    },
    "cap_initial": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cap Initial"
    },
    "duree_s": {
      "exclusiveMinimum": 0,
      "title": "Duree S",
      "type": "number"
    },
    "etapes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ScenarioStep"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Etapes"
    },
    "etapes_aleatoires": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Etapes Aleatoires"
    },
    "etapes_delai_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Etapes Delai S"
    },
    "evenements": {
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      },
      "title": "Evenements",
      "type": "array"
    },
    "flotte": {
      "items": {
        "$ref": "#/$defs/FleetMember"
      },
      "minItems": 1,
      "title": "Flotte",
      "type": "array"
    },
    "formation_depart": {
      "default": "column",
      "title": "Formation Depart",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Id",
      "type": "string"
    },
    "niveau": {
      "minLength": 1,
      "title": "Niveau",
      "type": "string"
    },
    "resume": {
      "minLength": 1,
      "title": "Resume",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "titre": {
      "minLength": 1,
      "title": "Titre",
      "type": "string"
    },
    "vitesse_initiale_kn": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vitesse Initiale Kn"
    }
  },
  "required": [
    "schema_version",
    "id",
    "titre",
    "niveau",
    "duree_s",
    "resume",
    "briefing",
    "flotte"
  ],
  "title": "ScenarioDocument",
  "type": "object"
