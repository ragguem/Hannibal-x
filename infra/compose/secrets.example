# Modèle des fichiers de /etc/hannibal/ (root:root, 0600). Valeurs à générer sur le serveur :
#   openssl rand -base64 32
# Ne jamais copier ces fichiers dans le dépôt, une image ou une sauvegarde de la base.

## /etc/hannibal/compose.env
HX_VERSION=1.0.0
HX_SITE_NAME=hannibal.local
HX_TLS=internal
# HX_TLS=/etc/caddy/certs/site.crt /etc/caddy/certs/site.key

## /etc/hannibal/postgres.env
POSTGRES_DB=hannibal
POSTGRES_USER=hannibal_owner
POSTGRES_PASSWORD=<à générer>

## /etc/hannibal/migrate.env
HX_API_DATABASE_URL=postgresql://hannibal_owner:<mot de passe>@postgres:5432/hannibal

## /etc/hannibal/api.env
HX_API_DATABASE_URL=postgresql://hannibal_app:<mot de passe>@postgres:5432/hannibal
HX_API_INTERNAL_TOKEN=<jeton interne commun>
HX_API_METRICS_TOKEN=<contenu de metrics.token>

## /etc/hannibal/backoffice.env
HX_BACKOFFICE_DATABASE_URL=Host=postgres;Port=5432;Database=hannibal;Username=hannibal_backoffice;Password=<mot de passe>
HX_BACKOFFICE_INTERNAL_TOKEN=<jeton interne commun>
HX_BACKOFFICE_METRICS_TOKEN=<contenu de metrics.token>
HX_BACKOFFICE_INITIAL_ADMIN_PASSWORD=<à générer, à changer à la première connexion>

## /etc/hannibal/asr.env, rerank.env, sim-bridge.env (même forme, préfixes HX_ASR_, HX_RERANK_, HX_SIM_BRIDGE_)
HX_ASR_INTERNAL_TOKEN=<jeton interne commun>
HX_ASR_METRICS_TOKEN=<contenu de metrics.token>

## /etc/hannibal/doctrine.env
HX_DOCTRINE_DATABASE_URL=postgresql://hannibal_doctrine:<mot de passe>@postgres:5432/hannibal
HX_DOCTRINE_INTERNAL_TOKEN=<jeton interne commun>
HX_DOCTRINE_METRICS_TOKEN=<contenu de metrics.token>

## /etc/hannibal/grafana.env
GF_SECURITY_ADMIN_PASSWORD=<à générer>

## /etc/hannibal/metrics.token   (une ligne, lue par Prometheus)
## /etc/hannibal/alert.env       (minuterie /v1/ready et sauvegarde)
HX_ALERT_COMMAND=logger -t hannibal-alert
HX_READY_URL=https://hannibal.local/v1/ready
HX_BACKUP_DIR=/mnt/sauvegarde/hannibal
