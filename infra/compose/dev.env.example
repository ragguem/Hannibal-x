# Copier en dev.env (ignoré par git) puis adapter.
HX_VERSION=0.1.0
HX_DEV_DB_PASSWORD=change-me-dev-only
# Compte « admin » créé au premier démarrage du back-office (tous les droits) ; vide : aucun compte
HX_DEV_ADMIN_PASSWORD=change-me-dev-only

# fake : sondes factices, aucune dépendance ; real : Postgres (et Ollama si HX_API_OLLAMA_URL est défini)
HX_API_ADAPTERS=real

# Avec le profil gpu : http://ollama:11434
HX_API_OLLAMA_URL=
HX_API_LOG_LEVEL=INFO

# scripted : la transcription renvoie toujours le même ordre ; whisper : vraie reconnaissance (processeur)
HX_ASR_ENGINE=scripted
HX_ASR_WHISPER_MODEL=small

# lexical : recouvrement de mots ; cross_encoder : bge-reranker (téléchargé dans le volume rerankmodels)
HX_RERANK_SCORER=lexical

# sample : corpus inventé, modèle scripté ; real : index v2 (rôle hannibal_doctrine) et Ollama (profil gpu)
HX_DOCTRINE_ADAPTERS=sample
# Mode real seulement, mot de passe hors dépôt : postgresql://hannibal_doctrine:<mot de passe>@postgres:5432/hannibal
HX_DOCTRINE_DATABASE_URL=
