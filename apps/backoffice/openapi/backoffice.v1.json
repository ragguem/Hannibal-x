            }
          }
        }
      },
      "UserViewBody": {
        "required": [
          "id",
          "username",
          "role",
          "created_at",
          "disabled_at",
          "password_changed_at"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "disabled_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "password_changed_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
